{
  "name": "sidebrowser-extension",
  "version": "1.6.5",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node scripts/export-icons.mjs",
    "store:capture": "npm run build && node scripts/store-capture.mjs",
    "store:render": "node scripts/store-render.mjs",
    "store:package": "npm run package && node scripts/store-package.mjs",
    "test": "npm run build && node --import tsx --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "dev": "node --import tsx scripts/build.ts --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && node --import tsx scripts/build.ts",
    "package": "npm run build && node --import tsx scripts/package.ts",
    "site:build": "npm run package && node scripts/site-build.mjs",
    "site:preview": "node scripts/site-serve.mjs",
    "site:check": "node scripts/site-check.mjs",
    "site:test:browser": "node scripts/site-browser-check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/node": "22.20.3",
    "fflate": "0.8.3",
    "playwright": "1.62.1",
    "prettier": "3.8.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
